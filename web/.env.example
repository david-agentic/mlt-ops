# Copy this file to .env.local and fill in real values.
# Never commit .env.local or .env — both are gitignored.

# Required. Neon Postgres pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional. Name of the session cookie. Defaults to "mlt_session".
SESSION_COOKIE_NAME="mlt_session"

# Optional. Only needed in production for payment-proof file uploads.
# Without it, uploads fall back to local disk (dev only) — see lib/storage.ts.
BLOB_READ_WRITE_TOKEN=""

# Optional. Resend API key for sending password-reset and invitation emails.
# Without it, those emails are logged (not sent) via lib/logger — see
# lib/email/index.ts. Get one at https://resend.com.
RESEND_API_KEY=""

# Optional. Must be a domain verified with Resend once RESEND_API_KEY is set.
# Defaults to Resend's own shared onboarding sender otherwise.
RESEND_FROM_EMAIL="MLT Ops <onboarding@resend.dev>"

# Required for correct password-reset/invitation links. The public base URL
# this app is reachable at (no trailing slash). Defaults to localhost:3000.
APP_URL="http://localhost:3000"
